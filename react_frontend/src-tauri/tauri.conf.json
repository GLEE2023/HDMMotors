{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GLEE HDM Mission Control",
  "version": "0.1.0",
  "identifier": "org.gleemission.hdm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title":"GLEE · HDM Mission Control","width":1520,"height":940,"minWidth":1080,"minHeight":720,"center":true,"backgroundColor":"#07101d"}],
    "security": {
      "csp":"default-src 'self'; img-src 'self' blob: data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {"active":true,"targets":["nsis"],"category":"Utility","icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.ico"]}
}
